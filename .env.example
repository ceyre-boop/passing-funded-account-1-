# Copy to .env, fill with real values. Never commit .env itself (gitignored).
# See the general repo's FUNDED_ACCOUNT_REPO_MANIFEST.md, section 9, for the
# reasoning on which keys this specific repo needs and why.

OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_LIVE=0
OANDA_BASE_URL=https://api-fxpractice.oanda.com

FRED_API_KEY=
ANTHROPIC_API_KEY=
NEWS_API_KEY=

# Alpaca. BOTH are required — the key id alone cannot authenticate.
# The secret is shown exactly once, at key creation; if you no longer have it,
# generate a new pair rather than hunting for it.
# Paper keys start with PK. daytrade/broker.py refuses any non-paper host, so a
# live key here would still not let it trade live.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
