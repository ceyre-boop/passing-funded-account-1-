# Copy to .env, fill with real values. Never commit .env itself (gitignored).
# See the general repo's FUNDED_ACCOUNT_REPO_MANIFEST.md, section 9, for the
# reasoning on which keys this specific repo needs and why.

OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_LIVE=0
OANDA_BASE_URL=https://api-fxpractice.oanda.com

FRED_API_KEY=
ANTHROPIC_API_KEY=
NEWS_API_KEY=

# Alpaca. BOTH are required — the key id alone cannot authenticate.
# The secret is shown exactly once, at key creation; if you no longer have it,
# generate a new pair rather than hunting for it.
# Paper keys start with PK. daytrade/broker.py refuses any non-paper host, so a
# live key here would still not let it trade live.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Polygon.io. Verified 2026-08-06 against the vendor only:
#   /v2/reference/news          200  — articles with per-ticker sentiment insights
#   /v2/aggs .../5/minute       200  — 04:00-19:55 ET, 192 bars/day, ~2yr history
#   /v2/last/nbbo               403  — real-time quotes need a paid tier
# Free tier is rate limited to ~5 requests/minute. Aggregates accept a date RANGE
# in one call, so a multi-year pull is a couple of requests, not one per day.
POLYGON_API_KEY=

# scripts/paper_carry_daily_tick.sh (the paper carry loop, 2026-08-26 dispatch).
# Required to schedule the loop unattended -- no code default exists anywhere
# in this repo (eval_size()/scripts/ruin_engine.py has not landed). Colin sets
# this number; it is never invented by a script.
PAPER_CARRY_RISK=
# PAPER_CARRY_FIRM=cti_1step   # optional, defaults to cti_1step if unset
