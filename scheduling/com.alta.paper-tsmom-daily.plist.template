<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template only -- NOT loaded by this repo and never installed by an agent.
  Install by hand (see scripts/paper_tsmom_daily_tick.sh's header):

    1. Replace REPO_ROOT below with the absolute path to this checkout.
    2. cp this file (dropping .template) to
       ~/Library/LaunchAgents/com.alta.paper-tsmom-daily.plist
    3. launchctl load ~/Library/LaunchAgents/com.alta.paper-tsmom-daily.plist

  Runs once daily, 15 minutes after com.alta.paper-carry-daily (22:00) so the
  two loops never overlap on the same bars/*.parquet refresh or the same
  decision log. 22:15 local, after both the London/NY sessions' closes have
  printed, so the day's closing bar exists for decide()/entry pricing.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alta.paper-tsmom-daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>REPO_ROOT/scripts/paper_tsmom_daily_tick.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>22</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>REPO_ROOT/data/agent/paper_tsmom_daily_launchd.log</string>
  <key>StandardErrorPath</key>
  <string>REPO_ROOT/data/agent/paper_tsmom_daily_launchd.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
