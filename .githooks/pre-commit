#!/bin/sh
# pre-commit — the carry bench must reproduce artifacts/bench.txt (spec 045 I70).
# A refactor that moves this number without intending to is a bug; block the commit.
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 scripts/carry_bench.py --check || { echo "pre-commit: carry bench mismatch — see scripts/carry_bench.py" >&2; exit 1; }
